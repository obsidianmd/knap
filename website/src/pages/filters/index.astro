---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { compiledContent, frontmatter, getHeadings } from '../../content/docs/filters.md';
import { filterDocs, filterGroups } from '../../../lib/filter-docs';

const escape = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
const byName = new Map(filterDocs.map((filter) => [filter.name, filter]));
const renderFilterRow = (filter: (typeof filterDocs)[number]) => `<a class="filter-row" href="/filters/${filter.slug}"><div><code>${escape(filter.name)}</code></div><p>${escape(filter.summary)}</p><span aria-hidden="true">→</span></a>`;
const groupedDirectory = filterGroups.map((group) => {
  const filters = group.filters.map((name) => byName.get(name)).filter(Boolean);
  return `<section class="filter-directory-group"><header><h3 id="filter-group-${group.id}">${escape(group.label)}</h3><p>${escape(group.intro)}</p></header><div class="filter-list">${filters.map((filter) => filter ? renderFilterRow(filter) : '').join('')}</div></section>`;
}).join('');
const directory = `<div class="filter-directory">${groupedDirectory}</div>`;
const content = (await compiledContent()).replace('<!-- FILTER_DIRECTORY -->', directory);
const headings = getHeadings().flatMap((heading) => heading.slug === 'built-in-filters'
  ? [heading, ...filterGroups.map((group) => ({ depth: 3, slug: `filter-group-${group.id}`, text: group.label }))]
  : [heading]);
---

<DocsLayout current="filters" title={frontmatter.title} description={frontmatter.description} headings={headings} markdownPath="/filters.md">
  <Fragment set:html={content} />
</DocsLayout>
