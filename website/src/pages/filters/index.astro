---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { compiledContent, frontmatter, getHeadings } from '../../content/docs/filters.md';
import { filterDocs, filterGroups } from '../../../lib/filter-docs';

const escape = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
const byName = new Map(filterDocs.map((filter) => [filter.name, filter]));
const renderFilterRow = (filter: (typeof filterDocs)[number]) => `<a class="filter-row" href="/filters/${filter.slug}"><div><code>${escape(filter.name)}</code>${filter.aliases?.length ? `<small>alias: ${escape(filter.aliases.join(', '))}</small>` : ''}</div><p>${escape(filter.summary)}</p><code class="filter-example">${escape(filter.syntax[0])}</code><span aria-hidden="true">→</span></a>`;
const groupedDirectory = filterGroups.map((group) => {
  const filters = group.filters.map((name) => byName.get(name)).filter(Boolean);
  return `<section class="filter-directory-group"><header><h3>${escape(group.label)}</h3><p>${escape(group.intro)}</p></header><div class="filter-list">${filters.map((filter) => filter ? renderFilterRow(filter) : '').join('')}</div></section>`;
}).join('');
const alphabeticalDirectory = [...filterDocs]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map(renderFilterRow)
  .join('');
const directory = `<div class="filter-directory">
  <div class="filter-view-switch" role="group" aria-label="Filter list view">
    <button type="button" data-filter-view-control="alphabetical" aria-pressed="true">A–Z</button>
    <button type="button" data-filter-view-control="grouped" aria-pressed="false">Grouped</button>
  </div>
  <div data-filter-view-panel="alphabetical">
    <section class="filter-directory-group filter-directory-alphabetical"><header><h3>All filters</h3><p>${filterDocs.length} filters in alphabetical order.</p></header><div class="filter-list">${alphabeticalDirectory}</div></section>
  </div>
  <div data-filter-view-panel="grouped" hidden>${groupedDirectory}</div>
</div>`;
const content = (await compiledContent()).replace('<!-- FILTER_DIRECTORY -->', directory);
const headings = getHeadings();
---

<DocsLayout current="filters" title={frontmatter.title} description={frontmatter.description} headings={headings} markdownPath="/filters.md">
  <Fragment set:html={content} />
</DocsLayout>
