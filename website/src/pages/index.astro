---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DocsNavigation from '../components/DocsNavigation.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GetStarted from '../components/GetStarted.astro';
import CairnHeadline from '../components/CairnHeadline.astro';
import LiveTemplateDemo from '../components/LiveTemplateDemo.astro';

const headings = [
  { depth: 2, slug: 'markdown-native-title', text: 'How it works' },
  { depth: 2, slug: 'terminal-title', text: 'Knap in your terminal' },
  { depth: 2, slug: 'install-title', text: 'Knap in your app' },
  { depth: 2, slug: 'explore-title', text: 'Explore' },
  { depth: 2, slug: 'knap-in-use', text: 'Knap in use' },
];
---

<BaseLayout markdownPath="/index.md" description="Knap is a simple language that turns data into Markdown using logic, variables, and filters.">
  <main id="top" class="docs-page home-page">
    <SiteHeader current="introduction" headings={headings} markdownPath="/index.md" />
    <div class="docs-layout home-layout">
      <DocsNavigation class="docs-toc" current="introduction" headings={headings} markdownPath="/index.md" />
      <div class="home-content">
        <section class="hero-shell">
          <div class="hero-grid">
            <div class="hero-copy">
              <CairnHeadline />
              <p class="lede">Knap is a simple template language that turns data into Markdown using <a href="/logic">logic</a>, <a href="/variables">variables</a>, and <a href="/filters">filters</a>.</p>
            </div>

          </div>
        </section>

        <LiveTemplateDemo />

        <GetStarted />

        <section class="guide-section" aria-labelledby="explore-title">
          <header class="guide-heading"><h2 id="explore-title">Explore</h2></header>
          <nav class="guide-links" aria-label="Language guides">
            <a class="guide-link-card" data-guide="variables" href="/variables">
              <h3>Variables</h3>
              <p>Insert values from your data into a template.</p>
            </a>
            <a class="guide-link-card" data-guide="filters" href="/filters">
              <h3>Filters</h3>
              <p>Transform values and format Markdown.</p>
            </a>
            <a class="guide-link-card" data-guide="logic" href="/logic">
              <h3>Logic</h3>
              <p>Include content conditionally and repeat it over arrays.</p>
            </a>
          </nav>
        </section>

        <section class="used-by" aria-labelledby="knap-in-use">
          <header class="used-by-heading"><div><h2 id="knap-in-use">Knap in use</h2></div><p>Knap is <a href="https://github.com/obsidianmd/knap" target="_blank" rel="noopener noreferrer">open source</a>. It started as the templating language for <a href="https://obsidian.md" target="_blank" rel="noopener noreferrer">Obsidian</a>. Now any tool can use it. Knap is named after <a href="https://en.wikipedia.org/wiki/Knapping" target="_blank" rel="noopener noreferrer">knapping</a>, the process of shaping stones to form arrowheads, scrapers, and other tools.</p></header>
          <div class="used-by-list">
            <a href="https://obsidian.md/clipper" class="used-by-card" target="_blank" rel="noopener noreferrer"><div class="used-by-copy"><h3>Obsidian Web Clipper</h3><span>Save web pages to Markdown with customizable templates.</span></div><strong aria-hidden="true">↗</strong></a>
            <a href="https://community.obsidian.md/plugins/obsidian-importer" class="used-by-card" target="_blank" rel="noopener noreferrer"><div class="used-by-copy"><h3>Obsidian Importer</h3><span>Convert data from many apps and file formats to portable Markdown files.</span></div><strong aria-hidden="true">↗</strong></a>
          </div>
        </section>

        <SiteFooter />
      </div>
    </div>
  </main>
</BaseLayout>
