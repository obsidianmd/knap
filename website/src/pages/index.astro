---
import BaseLayout from '../layouts/BaseLayout.astro';
import TemplateExample from '../components/TemplateExample.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Install from '../components/Install.astro';

const movieTemplate = `---
year: {{ year }}
director: {{ directors | wikilink }}
genre: {{ genres }}
---

# {{ title }}

{{ plot | blockquote }}

{% if cast %}
## Cast

{{ cast | slice:0,4 | table }}
{% endif %}`;

const markdownOutput = `---
year: 1999
director: ["[[Lana Wachowski]]","[[Lilly Wachowski]]"]
genre: ["Action","Sci-fi"]
---

# The Matrix

> A hacker discovers that reality is a simulation and joins a rebellion against its machines.

## Cast

| Actor | Role |
| - | - |
| Keanu Reeves | Neo |
| Laurence Fishburne | Morpheus |
| Carrie-Anne Moss | Trinity |
| Hugo Weaving | Agent Smith |`;
---

<BaseLayout markdownPath="/index.md" description="Knap is a simple language that lets you generate Markdown content from structured data. It converts data by following a template that you define with variables, filters, and logic.">
  <main class="home-page">
    <section class="hero-shell">
      <SiteHeader />
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>The template language for Markdown.</h1>
          <p class="lede">Knap is a simple language that lets you generate Markdown content from structured data. It converts data by following a template that you define with <a href="/variables">variables</a>, <a href="/filters">filters</a>, and <a href="/logic">logic</a>.</p>
        </div>

      </div>
    </section>

    <section class="markdown-native" aria-labelledby="markdown-native-title">
      <header class="markdown-native-heading">
        <h2 id="markdown-native-title">Example</h2>
      </header>
      <TemplateExample template={movieTemplate} markdown={markdownOutput} />
    </section>

    <Install />

    <section class="used-by" aria-labelledby="knap-in-use">
      <header class="used-by-heading"><div><h2 id="knap-in-use">Knap in use</h2></div><p>Knap was created for <a href="https://obsidian.md">Obsidian</a> and is named after <a href="https://en.wikipedia.org/wiki/Knapping">flintknapping</a>, the process of shaping stones to form arrowheads, scrapers, and other tools.</p></header>
      <div class="used-by-list">
        <a href="https://obsidian.md/clipper" class="used-by-card"><div class="used-by-copy"><h3>Obsidian Web Clipper</h3><span>Renders page data, highlights, selectors, and custom variables through user-defined templates before saving them as Markdown.</span></div><strong aria-hidden="true">↗</strong></a>
        <a href="https://community.obsidian.md/plugins/obsidian-importer" class="used-by-card"><div class="used-by-copy"><h3>Obsidian Importer</h3><span>Applies templates and filters to imported fields so notes from other apps arrive in a consistent Markdown structure.</span></div><strong aria-hidden="true">↗</strong></a>
      </div>
    </section>

    <section class="feature-grid" aria-labelledby="why-knap">
      <div class="section-heading"><h2 id="why-knap">Why Knap?</h2></div>
      <ul class="feature-list">
        <li><strong>Safe by design.</strong> An AST interpreter handles templates. Knap does not use eval or execute arbitrary JavaScript.</li>
        <li><strong>Application-owned.</strong> Apps supply variables, asynchronous resolvers, and custom filters. Knap is independent of any host environment.</li>
        <li><strong>Useful diagnostics.</strong> Errors and warnings include stable codes, messages, lines, and columns for editor tooling and helpful user feedback.</li>
      </ul>
    </section>

    <SiteFooter markdownPath="/index.md" />
  </main>
</BaseLayout>
