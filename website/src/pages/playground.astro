---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaygroundEditor from '../components/PlaygroundEditor.astro';
import Search from '../components/Search.astro';
import MobileDocsMenu from '../components/MobileDocsMenu.astro';
import { exampleInput, exampleTemplate } from '../lib/playground';
import { homeExamples } from '../lib/home-examples';
import { storageKey, minimumWidth } from '../scripts/playground-columns';
import '../styles/playground.scss';
import { playgroundFilterSuggestions as filters } from '../../lib/filter-completions';
---

<BaseLayout title="Playground" description="Try Knap in your browser. Edit JSON data and a template to generate Markdown with live template validation.">
  <main class="playground" data-active-panel="template">
    <script is:inline define:vars={{ storageKey, minimumWidth }}>
      // Prevent iOS from zooming into our small editors on focus. Safari still
      // permits manual pinch zoom; keep other platforms' viewport unrestricted.
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent)
        || (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
      if (isIOS) {
        const viewport = document.querySelector('meta[name="viewport"]');
        if (viewport) viewport.content += ', maximum-scale=1';
      }
      // Keep the panel frames stable while the editable layers initialize.
      const playground = document.currentScript.parentElement;
      playground.dataset.initializing = '';
      const showEditors = () => playground.removeAttribute('data-initializing');
      const startupTimeout = setTimeout(showEditors, 8000);
      playground.addEventListener('playground-ready', () => {
        clearTimeout(startupTimeout);
        showEditors();
      }, { once: true });
      // Restore column widths before their markup can paint, without waiting for modules.
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) ?? 'null');
        if (Array.isArray(saved) && saved.length === 3 && saved.every((value) => typeof value === 'number' && Number.isFinite(value) && value > 0 && value <= 1)) {
          const total = saved.reduce((sum, value) => sum + value, 0);
          const tracks = saved.map((value) => `minmax(${minimumWidth}px, ${value / total}fr)`).join(' 1px ');
          document.currentScript.parentElement.style.setProperty('--playground-tracks', tracks);
        }
      } catch {
        // Unavailable storage or invalid preferences keep the default equal columns.
      }
    </script>
    <script is:inline type="application/json" id="playground-filter-completions" set:html={JSON.stringify(filters).replaceAll('<', '\\u003c')} />
    <div class="playground-header-slot" data-scroll-header-slot>
    <header class="playground-header" data-scroll-header>
      <div class="playground-brand">
        <a class="wordmark" href="/" aria-label="Knap home">Knap</a>
        <h1>Playground</h1>
      </div>
      <div class="playground-actions">
          <button class="header-action" type="button" id="playground-settings" aria-label="Playground settings" title="Settings" aria-haspopup="menu" aria-expanded="false" aria-controls="playground-settings-menu">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            <span>Settings</span>
          </button>
          <div id="playground-settings-menu" class="menu" role="menu" aria-labelledby="playground-settings" hidden>
            <button type="button" id="open-file" data-open-file role="menuitem" tabindex="-1">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2" /></svg>
              <span class="menu-label">Open file…</span>
            </button>
            <div class="menu-submenu">
              <button type="button" id="open-sample" role="menuitem" tabindex="-1" aria-haspopup="menu" aria-expanded="false" aria-controls="playground-samples-menu">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2" /><path d="M8 7h8M8 11h8M8 15h4" /></svg>
                <span class="menu-label">Open sample</span>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
              </button>
              <div id="playground-samples-menu" class="menu" role="menu" aria-labelledby="open-sample" hidden>
                {homeExamples.map((example) => (
                  <button type="button" role="menuitem" tabindex="-1" data-playground-sample={example.key}>{example.label}</button>
                ))}
              </div>
            </div>
            <button type="button" id="share-playground" role="menuitem" tabindex="-1" data-menu-keep-open>
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
              <span class="menu-label" aria-live="polite">Copy share link</span>
            </button>
            <button type="button" id="reset-example" role="menuitem" tabindex="-1">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
              <span class="menu-label">Reset</span>
            </button>
            <button type="button" id="clear-playground" role="menuitem" tabindex="-1">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
              <span class="menu-label">Clear</span>
            </button>
            <div class="menu-separator" role="separator"></div>
            <button type="button" id="wrap-lines" role="menuitemcheckbox" aria-checked="false" tabindex="-1">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16-3 3 3 3" /><path d="M3 12h14.5a1 1 0 0 1 0 7H13" /><path d="M3 19h6" /><path d="M3 5h18" /></svg>
              <span class="menu-label">Line wrap</span>
              <svg class="menu-check" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5" /></svg>
            </button>
          </div>
          <input type="file" data-file-input accept=".json,.txt,.md" aria-label="Choose JSON data or a template file" hidden />
      </div>
      <Search />
      <MobileDocsMenu />
    </header>
    </div>
    <div class="playground-tabs segmented-control" style="--segment-count: 3" role="tablist" aria-label="Playground editors">
      {['input', 'template', 'output'].map((name) => (
        <button type="button" role="tab" id={`${name}-tab`} aria-controls={`${name}-panel`} aria-selected={name === 'template'} tabindex={name === 'template' ? 0 : -1} data-playground-tab={name}>
          {name === 'input' ? 'Data' : name[0].toUpperCase() + name.slice(1)}
        </button>
      ))}
    </div>
    <div class="playground-columns">
      <PlaygroundEditor name="input" label="Data" language="JSON" value={exampleInput} />
      <div
        class="playground-resizer"
        role="separator"
        tabindex="0"
        aria-label="Resize data and template columns"
        aria-orientation="vertical"
        aria-controls="input-panel template-panel"
        aria-valuenow="50"
        title="Drag to resize. Use arrow keys when focused. Double-click to equalize."
      ></div>
      <PlaygroundEditor name="template" label="Template" language="Knap" value={exampleTemplate} />
      <div
        class="playground-resizer"
        role="separator"
        tabindex="0"
        aria-label="Resize template and output columns"
        aria-orientation="vertical"
        aria-controls="template-panel output-panel"
        aria-valuenow="50"
        title="Drag to resize. Use arrow keys when focused. Double-click to equalize."
      ></div>
      <PlaygroundEditor name="output" label="Output" language="Markdown" readonly />
    </div>
    <noscript>Enable JavaScript to render and validate templates in the playground.</noscript>
  </main>
</BaseLayout>

<script>
  import '../scripts/playground';
</script>
