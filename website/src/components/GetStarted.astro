---
import CodeBlock from './CodeBlock.astro';
import Install from './Install.astro';
---

<section class="get-started" aria-labelledby="get-started-title">
  <header class="install-heading">
    <h2 id="get-started-title">Get started</h2>
  </header>

  <section class="get-started-terminal" aria-labelledby="terminal-title">
    <header class="install-heading">
      <h3 id="terminal-title">Use in the terminal</h3>
      <p>Generate Markdown from a template and JSON data.</p>
    </header>
    <CodeBlock language="shell" code="npx knap render template.md --data data.json --output note.md" highlight={false} />
    <p>Try it without creating any files:</p>
    <CodeBlock language="shell" code={'npx knap render -t \'# {{ title }}\' --set title=Hello'} highlight={false} />
    <p class="get-started-link">Read the <a href="/cli">CLI guide</a> for input options, piping, and installation.</p>
  </section>

  <Install title="Use in your app" headingLevel="h3">
    <p class="get-started-link">Read the <a href="/api">API reference</a> to configure and render templates in your app.</p>
  </Install>
</section>
