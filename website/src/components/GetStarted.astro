---
import CodeBlock from './CodeBlock.astro';
import Install from './Install.astro';
---

<div class="get-started">
  <section class="get-started-terminal" aria-labelledby="terminal-title">
    <header class="install-heading">
      <h2 id="terminal-title">Knap in your terminal</h2>
    </header>
    <p class="get-started-link">Generate Markdown from Knap templates. Read the <a href="/cli">CLI guide</a> for options.</p>
    <CodeBlock language="shell" code="npx knap render template.md --data data.json --output note.md" />
  </section>

  <Install title="Knap in your app" showDescription={false}>
    <p slot="description" class="get-started-link">Add Knap templating to your app using the <a href="/api">API</a>.</p>
  </Install>
</div>
