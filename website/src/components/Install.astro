---
import CodeBlock from './CodeBlock.astro';

const managers = [
  { name: 'npm', command: 'npm install knap' },
  { name: 'pnpm', command: 'pnpm add knap' },
  { name: 'yarn', command: 'yarn add knap' },
  { name: 'bun', command: 'bun add knap' },
];
---

<section class="install-section" aria-labelledby="install-title">
  <header class="install-heading">
    <h2 id="install-title">Install</h2>
    <a href="/api#quick-start">Quick start →</a>
  </header>
  <div class="install-managers segmented-control" style={`--segment-count: ${managers.length}`} role="group" aria-label="Package manager">
    {managers.map(({ name }, index) => (
      <button type="button" data-install-manager={name} aria-pressed={index === 0} aria-controls={`install-${name}`}>{name}</button>
    ))}
  </div>
  {managers.map(({ name, command }, index) => (
    <div id={`install-${name}`} data-install-panel={name} hidden={index !== 0}>
      <CodeBlock language="shell" code={command} />
    </div>
  ))}
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-install-manager]');
  const panels = document.querySelectorAll<HTMLElement>('[data-install-panel]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const manager = button.dataset.installManager;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      panels.forEach((panel) => { panel.hidden = panel.dataset.installPanel !== manager; });
    });
  });
</script>
