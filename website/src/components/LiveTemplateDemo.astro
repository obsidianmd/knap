---
import { createEngine, standardFilters } from '../../../src';
import { homeExamples } from '../lib/home-examples';
import { highlightCode } from '../lib/highlight';
import LiveTemplateExample from './LiveTemplateExample.astro';

const movie = homeExamples.find((example) => example.key === 'movie')!;
const variables = { cast: movie.variables.cast };
const playground = { input: JSON.stringify(movie.variables, null, 2), template: movie.template };
const engine = createEngine({ filters: standardFilters });
const castPrefix = '{% if cast %}\n{{ ';
const castSuffix = ' }}\n{% endif %}';
const steps = await Promise.all([
  { expression: 'if cast', prefix: '{% ', suffix: ' %}\n{% endif %}' },
  { expression: 'cast', prefix: castPrefix, suffix: castSuffix },
  { expression: 'cast | sort:"Actor"', prefix: castPrefix, suffix: castSuffix },
  { expression: 'cast | sort:"Actor" | table', prefix: castPrefix, suffix: castSuffix },
].map(async (step) => {
  const template = step.prefix + step.expression + step.suffix;
  const result = await engine.render(template, { variables });
  if (result.errors.length) throw new Error(result.errors[0].message);
  return {
    ...step,
    template,
    rawOutput: result.output,
    output: highlightCode(result.output, 'md'),
  };
}));

const markdownTemplate = `# {{ title }}

**Plot:**
{{ plot | blockquote }}`;
const markdownVariables = { title: movie.variables.title, plot: movie.variables.plot };
const markdownPlayground = { input: JSON.stringify(markdownVariables, null, 2), template: markdownTemplate };
const markdownPrefix = '# {{ title }}\n\n**Plot:**\n{{ ';
const markdownSteps = await Promise.all([
  { expression: 'title', prefix: '# {{ ', suffix: ' }}' },
  { expression: 'plot', prefix: markdownPrefix, suffix: ' }}' },
  { expression: 'plot | blockquote', prefix: markdownPrefix, suffix: ' }}' },
].map(async (step) => {
  const template = step.prefix + step.expression + step.suffix;
  const result = await engine.render(template, { variables: markdownVariables });
  if (result.errors.length) throw new Error(result.errors[0].message);
  return {
    ...step,
    template,
    rawOutput: result.output,
    output: highlightCode(result.output, 'md'),
  };
}));
---

<LiveTemplateExample
  id="live-template-title"
  label="How it works"
  labelId="markdown-native-title"
  playground={playground}
  steps={steps}
/>

<LiveTemplateExample
  id="markdown-template-example"
  label="Knap lets you mix Markdown and dynamic content in the same template."
  labelAs="p"
  playground={markdownPlayground}
  steps={markdownSteps}
  timeline="markdown"
/>

<script>
  import '../scripts/live-template-demo';
</script>
