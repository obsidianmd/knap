---
import type { DemoStep } from '../lib/live-template-timeline';
import { highlightLines } from '../lib/highlight';
import CopyButton from './CopyButton.astro';
import PlaygroundLink from './PlaygroundLink.astro';

interface Step extends DemoStep {
  template: string;
  rawOutput: string;
}

interface Props {
  id: string;
  label: string;
  labelAs?: 'h2' | 'p';
  labelId?: string;
  playground: { input: string; template: string };
  steps: Step[];
  timeline?: 'logic' | 'markdown';
}

const { id, label, labelAs = 'h2', labelId = `${id}-label`, playground, steps, timeline = 'logic' } = Astro.props;
const initial = steps[steps.length - 1];
const final = steps[steps.length - 1];
const finalTemplate = highlightLines(final.template.split('\n'), 'knap').join('\n');
---

<section
  id={id}
  class="live-template-section"
  aria-labelledby={labelId}
  data-live-template
  data-demo-timeline={timeline}
  data-steps={JSON.stringify(steps)}
>
  <header class:list={['home-example-heading', { 'live-template-intro': labelAs === 'p' }]}>
    {labelAs === 'h2'
      ? <h2 id={labelId}>{label}</h2>
      : <p id={labelId} class="live-template-copy">{label}</p>}
    <PlaygroundLink {...playground} />
  </header>

  <div class="template-output-panel">
    <div class="template-output-block template-output-template">
      <div class="template-output-label">
        <span>Template</span>
        <span class="doc-code-actions">
          <button class="doc-code-copy" type="button" title="Replay animation" aria-label="Replay animation" data-demo-rewind>
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
            </svg>
          </button>
          <CopyButton copyText={final.template} label="Copy final template" />
        </span>
      </div>
      <div class="live-template-content">
        <pre class="live-template-current" aria-label="Template"><code data-demo-template set:html={highlightLines(initial.template.split('\n'), 'knap').join('\n')} /></pre>
        <pre class="live-template-final" aria-hidden="true" inert><code set:html={finalTemplate} /></pre>
      </div>
    </div>
    <div class="template-output-block template-output-result">
      <div class="template-output-label">
        <span>Output</span>
        <span class="doc-code-actions"><CopyButton copyText={final.rawOutput} label="Copy final output" /></span>
      </div>
      <div class="template-output-content live-template-content">
        <div class="doc-code live-template-current"><pre aria-label="Template output"><code data-demo-output set:html={initial.output} /></pre></div>
        <div class="doc-code live-template-final" aria-hidden="true" inert><pre><code set:html={final.output} /></pre></div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .live-template-section {
    width: 100%;
    margin: 0 auto;
  }
  .live-template-intro {
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .live-template-intro .live-template-copy {
    flex: 1 1 30rem;
    margin: 0;
  }
  .live-template-content {
    position: relative;
    display: grid;
  }
  .live-template-current {
    position: absolute;
    inset: 0;
  }
  .live-template-final {
    visibility: hidden;
    user-select: none;
    pointer-events: none;
  }
  .template-output-template :global(.live-template-cursor) {
    position: relative;
    display: inline-block;
    width: 0;
    height: 1.1em;
    vertical-align: -0.15em;
  }
  .template-output-template :global(.live-template-cursor::after) {
    position: absolute;
    inset: 0 auto 0 -1px;
    width: 2px;
    background: var(--paper);
    content: '';
  }
</style>
