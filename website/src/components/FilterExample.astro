---
import CodeBlock from './CodeBlock.astro';

interface Props {
  input: string;
  template: string;
  output: string;
  runnable?: boolean;
}

const { input, template, output, runnable = true } = Astro.props;
---

<div class="filter-example-table">
  <table>
    <tbody>
      <tr>
        <th scope="row">Input</th>
        <td><CodeBlock code={input} language="json" /></td>
      </tr>
      <tr>
        <th scope="row">Template</th>
        <td><CodeBlock code={template} playground={runnable ? { input, template } : undefined} /></td>
      </tr>
      <tr>
        <th scope="row">Output</th>
        <td><CodeBlock code={output} language="md" /></td>
      </tr>
    </tbody>
  </table>
</div>
