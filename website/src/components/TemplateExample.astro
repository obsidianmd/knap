---
import CodeBlock from './CodeBlock.astro';

interface Example {
  key: string;
  label: string;
  template: string;
  markdown: string;
  variables: Record<string, unknown>;
}

interface Props {
  examples: Example[];
  defaultExample?: string;
}

const { examples, defaultExample = examples[0]?.key } = Astro.props;
const defaultExampleLabel = examples.find((example) => example.key === defaultExample)?.label ?? examples[0]?.label;
const tabs = [
  { key: 'template', label: 'Template' },
  { key: 'markdown', label: 'Output' },
] as const;
---

<div class="template-example" data-template-example>
  <div class="template-example-toolbar">
    <div class="example-tabs segmented-control" style="--segment-count: 2" role="tablist" aria-label="Code example">
      {tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`home-example-${tab.key}-tab`}
          aria-controls={`home-example-${tab.key}`}
          aria-selected={index === 0}
          tabindex={index === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="example-controls">
      <div class="example-picker" data-example-picker>
        <button
          class="example-picker-trigger"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="home-example-options"
          data-example-trigger
        >
          <span data-example-label>{defaultExampleLabel}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <div class="example-picker-menu menu" id="home-example-options" role="listbox" aria-label="Choose an example" data-example-menu hidden>
          {examples.map((example) => (
            <button
              type="button"
              role="option"
              aria-selected={example.key === defaultExample}
              tabindex="-1"
              data-example-option={example.key}
            >
              <span class="menu-label">{example.label}</span>
              <svg class="menu-check" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m20 6-11 11-5-5"></path>
              </svg>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="code-tab-panels">
    {tabs.map((tab, index) => (
      <div
        id={`home-example-${tab.key}`}
        role="tabpanel"
        aria-labelledby={`home-example-${tab.key}-tab`}
        tabindex="0"
        hidden={index !== 0}
      >
        {examples.map((example) => (
          <div data-example-variant={example.key} hidden={example.key !== defaultExample}>
            <CodeBlock
              language={tab.key === 'markdown' ? 'md' : 'knap'}
              code={tab.key === 'markdown' ? example.markdown : example.template}
              playground={{ input: JSON.stringify(example.variables, null, 2), template: example.template }}
            />
          </div>
        ))}
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-template-example]').forEach((example) => {
    const tabs = [...example.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...example.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const picker = example.querySelector<HTMLElement>('[data-example-picker]');
    const trigger = example.querySelector<HTMLButtonElement>('[data-example-trigger]');
    const menu = example.querySelector<HTMLElement>('[data-example-menu]');
    const label = example.querySelector<HTMLElement>('[data-example-label]');
    const choices = [...example.querySelectorAll<HTMLButtonElement>('[data-example-option]')];
    const variants = [...example.querySelectorAll<HTMLElement>('[data-example-variant]')];
    let currentKey = choices.find((choice) => choice.getAttribute('aria-selected') === 'true')?.dataset.exampleOption ?? choices[0]?.dataset.exampleOption;

    const selectTab = (selected: HTMLButtonElement) => {
      tabs.forEach((tab) => {
        tab.setAttribute('aria-selected', String(tab === selected));
        tab.tabIndex = tab === selected ? 0 : -1;
      });
      panels.forEach((panel) => { panel.hidden = panel.id !== selected.getAttribute('aria-controls'); });
    };

    const selectExample = (key: string) => {
      variants.forEach((variant) => { variant.hidden = variant.dataset.exampleVariant !== key; });
      choices.forEach((choice) => { choice.setAttribute('aria-selected', String(choice.dataset.exampleOption === key)); });
      currentKey = key;
      const selectedLabel = choices.find((choice) => choice.dataset.exampleOption === key)?.textContent?.trim();
      if (selectedLabel) {
        if (label) label.textContent = selectedLabel;
      }
    };

    const closePicker = () => {
      if (menu) menu.hidden = true;
      trigger?.setAttribute('aria-expanded', 'false');
    };

    const openPicker = (focus: 'selected' | 'first' | 'last' = 'selected') => {
      if (!menu || !trigger) return;
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      const target = focus === 'first'
        ? choices[0]
        : focus === 'last'
          ? choices.at(-1)
          : choices.find((choice) => choice.dataset.exampleOption === currentKey) ?? choices[0];
      target?.focus();
    };

    trigger?.addEventListener('click', () => {
      if (menu?.hidden) openPicker();
      else closePicker();
    });
    trigger?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        openPicker(event.key === 'ArrowDown' ? 'first' : 'last');
      }
    });
    choices.forEach((choice, index) => {
      choice.addEventListener('click', () => {
        const key = choice.dataset.exampleOption;
        if (key) selectExample(key);
        closePicker();
        trigger?.focus();
      });
      choice.addEventListener('keydown', (event) => {
        let nextIndex: number;
        if (event.key === 'ArrowDown') nextIndex = (index + 1) % choices.length;
        else if (event.key === 'ArrowUp') nextIndex = (index - 1 + choices.length) % choices.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = choices.length - 1;
        else if (event.key === 'Escape') {
          event.preventDefault();
          closePicker();
          trigger?.focus();
          return;
        } else if (event.key === 'Tab') {
          closePicker();
          return;
        } else return;
        event.preventDefault();
        choices[nextIndex]?.focus();
      });
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !picker?.contains(event.target)) closePicker();
    });
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        let nextIndex: number;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        const nextTab = tabs[nextIndex];
        selectTab(nextTab);
        nextTab.focus();
      });
    });
  });
</script>
