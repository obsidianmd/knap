---
import CodeTabs from './CodeTabs.astro';

interface Props {
  template: string;
  markdown: string;
}

const { template, markdown } = Astro.props;
---

<CodeTabs
  id="home-example"
  defaultTab="template"
  tabs={[
    { key: 'template', label: 'Template', code: template },
    { key: 'markdown', label: 'Markdown', code: markdown, language: 'md' },
  ]}
/>
