---
interface Props {
  name: 'input' | 'template' | 'output';
  label: string;
  language: string;
  value?: string;
  readonly?: boolean;
}

const { name, label, language, value = '', readonly = false } = Astro.props;
const accept = name === 'input' ? '.json' : '.md,.txt';
const fileTypes = name === 'input' ? '.json' : '.md or .txt';
---

<section class="playground-panel" id={`${name}-panel`} aria-labelledby={`${name}-heading`}>
  <header class="playground-panel-header">
    <h2 id={`${name}-heading`}>{label}</h2>
    <span class="playground-language">{language}</span>
    {!readonly && <>
      <button type="button" class="playground-open" data-open-file aria-label={`Open ${label.toLowerCase()} file`} title={`Open a ${fileTypes} file`}>Open</button>
      <input type="file" data-file-input accept={accept} aria-label={`Choose ${label.toLowerCase()} file`} hidden />
    </>}
    <button type="button" class="doc-code-copy playground-copy" id={`copy-${name}`} title={`Copy ${label.toLowerCase()}`} aria-label={`Copy ${label.toLowerCase()}`} disabled={!value}>
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
    </button>
  </header>
  {!readonly && <>
    <div class="playground-drop-hint" aria-hidden="true" hidden>Drop a {fileTypes} file</div>
    <div class="playground-file-status" id={`${name}-file-status`} role="status" aria-atomic="true" hidden></div>
  </>}
  <div class="playground-editor" data-editor={name}>
    <pre class="playground-line-numbers" aria-hidden="true"></pre>
    <div class="playground-editor-content">
      <pre class="playground-highlight" aria-hidden="true"></pre>
      <textarea
        id={`playground-${name}`}
        aria-label={label}
        aria-describedby={readonly ? `${name}-status` : `${name}-status ${name}-file-status`}
        readonly={readonly}
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        wrap="off"
      >{value}</textarea>
    </div>
  </div>
  <div class="playground-status" id={`${name}-status`} role="status" aria-atomic="true">
    {!readonly && <span class="playground-status-message">
      <svg class="playground-status-icon playground-status-icon-loading" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2a10 10 0 1 0 10 10" />
      </svg>
      <span>Checking…</span>
    </span>}
  </div>
</section>
