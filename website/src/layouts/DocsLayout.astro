---
import BaseLayout from './BaseLayout.astro';
import FooterNav from '../components/FooterNav.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  current: 'variables' | 'logic' | 'filters' | 'api';
  title: string;
  description: string;
  headings?: Heading[];
  markdownPath: string;
  fitTitle?: boolean;
}

const { current, title, description, headings = [], markdownPath, fitTitle = false } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2);
const guideLinks = [
  { href: '/variables', label: 'Variables', key: 'variables' },
  { href: '/logic', label: 'Logic', key: 'logic' },
  { href: '/filters', label: 'Filters', key: 'filters' },
];
---

<BaseLayout title={title} description={description} markdownPath={markdownPath}>
  <main class="docs-page">
    <SiteHeader />
    <div class="docs-layout">
      <aside class="docs-sidebar" aria-label="Documentation navigation">
        <div class="sidebar-group">
          <p>Guide</p>
          {guideLinks.map((link) => <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>{link.label}</a>)}
        </div>
        <div class="sidebar-group"><p>Reference</p><a href="/api" aria-current={current === 'api' ? 'page' : undefined}>API</a></div>
        <div class="sidebar-group sidebar-external"><p>Project</p><a href="https://github.com/obsidianmd/knap">GitHub ↗</a><a href="https://www.npmjs.com/package/knap">npm ↗</a></div>
      </aside>

      <article class="docs-content">
        <header class="docs-title">
          <h1 class:list={{ 'docs-title-fit': fitTitle }} style={fitTitle ? `--docs-title-fit: ${205 / title.length}cqw` : undefined}>{title}</h1>
          <p>{description}</p>
          <div class="docs-title-actions">
            <button class="docs-title-action" type="button" data-copy-markdown={markdownPath} aria-live="polite">
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
              <span>Copy Markdown</span>
            </button>
            <a class="docs-title-action" href={markdownPath}>
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" x2="8" y1="13" y2="13"></line><line x1="16" x2="8" y1="17" y2="17"></line><line x1="10" x2="8" y1="9" y2="9"></line></svg>
              <span>View Markdown</span>
            </a>
          </div>
        </header>
        <div class="markdown-doc"><slot /></div>
        <footer class="docs-footer"><span>Knap is open source under the MIT license.</span><FooterNav /><span><a href={markdownPath}>Markdown</a> · <a href="https://github.com/obsidianmd/knap">View source ↗</a></span></footer>
      </article>

      <aside class="docs-toc" aria-label="On this page"><p>On this page</p>{toc.map((item) => <a href={`#${item.slug}`}>{item.text}</a>)}</aside>
    </div>
  </main>
</BaseLayout>
