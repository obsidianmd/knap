{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "knap",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "knap.md",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
