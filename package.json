{
	"name": "knap",
	"version": "0.4.2",
	"description": "A flexible template engine for creating Markdown.",
	"keywords": [
		"template",
		"markdown",
		"obsidian"
	],
	"homepage": "https://github.com/obsidianmd/knap#readme",
	"bugs": "https://github.com/obsidianmd/knap/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/obsidianmd/knap.git"
	},
	"author": "Obsidian",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"knap": "./dist/cli.js"
	},
	"typesVersions": {
		"*": {
			"html": [
				"dist/html.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./html": {
			"types": "./dist/html.d.ts",
			"import": "./dist/html.js",
			"require": "./dist/html.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"bench": "vitest bench --run",
		"typecheck": "tsc --noEmit",
		"check": "pnpm typecheck && pnpm test && pnpm build",
		"prepack": "pnpm check"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@10.20.0",
	"pnpm": {
		"overrides": {
			"tsup>esbuild": "^0.28.1"
		}
	},
	"dependencies": {
		"dayjs": "^1.11.23"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
